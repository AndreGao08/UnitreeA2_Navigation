<?xml version="1.0"?>
<package format="3">
  <name>a2_terrain_nav</name>
  <version>0.1.0</version>
  <description>Terrain-aware Nav2 bringup for the Unitree A2 and Hesai JT128.</description>
  <maintainer email="maintainer@example.com">Unitree A2 Navigation</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>a2_localization_bringup</exec_depend>
  <exec_depend>a2_dual_lidar_nav</exec_depend>
  <exec_depend>a2_map_localization</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>ground_segmentation_ros2</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_ground_consistency_costmap_plugin</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>rmw_cyclonedds_cpp</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
