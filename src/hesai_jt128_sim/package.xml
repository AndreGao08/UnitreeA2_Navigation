<?xml version="1.0"?>
<package format="3">
  <name>hesai_jt128_sim</name>
  <version>0.1.0</version>
  <description>Converts Gazebo GPU LiDAR and IMU output to the FAST-LIO Hesai JT128 contract.</description>
  <maintainer email="maintainer@example.com">Unitree A2 Localization</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
