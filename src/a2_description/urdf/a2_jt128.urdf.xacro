<robot name="a2" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    The simulated Hesai optical frame is colocated with Unitree's front LiDAR
    housing and kept configurable for measured hardware calibration.
    ROS convention: x forward, y left, z up.
  -->
  <xacro:arg name="lidar_xyz" default="0.33767 0.0 0.08134"/>
  <xacro:arg name="lidar_rpy" default="0.0 0.0 0.0"/>
  <xacro:arg name="lidar_horizontal_samples" default="256"/>
  <xacro:arg name="lidar_update_rate" default="10"/>
  <xacro:arg name="lidar_visualize" default="false"/>
  <xacro:arg name="locomotion_mode" default="kinematic"/>
  <xacro:property name="dynamic_mode"
                  value="${'$(arg locomotion_mode)' != 'kinematic'}"/>
  <xacro:property name="assisted_mode"
                  value="${'$(arg locomotion_mode)' == 'gait_demo'}"/>

  <xacro:macro name="joint_position_controller"
               params="joint position p_gain d_gain effort topic:=''">
    <gazebo>
      <plugin filename="ignition-gazebo-joint-position-controller-system"
              name="ignition::gazebo::systems::JointPositionController">
        <joint_name>${joint}</joint_name>
        <initial_position>${position}</initial_position>
        <xacro:if value="${topic != ''}"><topic>${topic}</topic></xacro:if>
        <p_gain>${p_gain}</p_gain>
        <i_gain>0.0</i_gain>
        <d_gain>${d_gain}</d_gain>
        <cmd_max>${effort}</cmd_max>
        <cmd_min>${-effort}</cmd_min>
      </plugin>
    </gazebo>
  </xacro:macro>

